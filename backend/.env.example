# ─────────────────────────────────────────────────────────────
# AgriGIS Backend — Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your values below
# 3. NEVER commit .env to Git — it contains secrets!
# ─────────────────────────────────────────────────────────────

# Your Google Cloud Project ID  (e.g.  my-agrigis-app-123)
GEE_PROJECT_ID=your-gcp-project-id

# Service account email  (from GCP → IAM → Service Accounts)
# If left blank, the email is read directly from service_account.json
GEE_SERVICE_ACCOUNT_EMAIL=

# Path to the service account JSON key file
# Relative paths are resolved from the backend/ directory
GEE_SERVICE_ACCOUNT_KEY=service_account.json
